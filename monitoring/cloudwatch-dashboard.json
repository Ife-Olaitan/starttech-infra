{
  "widgets": [
    {
      "type": "metric",
      "x": 0,
      "y": 0,
      "width": 12,
      "height": 6,
      "properties": {
        "title": "EC2 CPU Utilization",
        "metrics": [
          ["AWS/EC2", "CPUUtilization", "AutoScalingGroupName", "starttech-asg", { "stat": "Average" }]
        ],
        "period": 300,
        "region": "eu-west-2"
      }
    },
    {
      "type": "metric",
      "x": 12,
      "y": 0,
      "width": 12,
      "height": 6,
      "properties": {
        "title": "ALB Request Count",
        "metrics": [
          ["AWS/ApplicationELB", "RequestCount", "LoadBalancer", "app/starttech-alb/xxxxx", { "stat": "Sum" }]
        ],
        "period": 300,
        "region": "eu-west-2"
      }
    },
    {
      "type": "metric",
      "x": 0,
      "y": 6,
      "width": 12,
      "height": 6,
      "properties": {
        "title": "ALB Target Response Time",
        "metrics": [
          ["AWS/ApplicationELB", "TargetResponseTime", "LoadBalancer", "app/starttech-alb/xxxxx", { "stat": "Average" }]
        ],
        "period": 300,
        "region": "eu-west-2"
      }
    },
    {
      "type": "metric",
      "x": 12,
      "y": 6,
      "width": 12,
      "height": 6,
      "properties": {
        "title": "ALB Healthy/Unhealthy Hosts",
        "metrics": [
          ["AWS/ApplicationELB", "HealthyHostCount", "TargetGroup", "targetgroup/starttech-tg/xxxxx", "LoadBalancer", "app/starttech-alb/xxxxx", { "stat": "Average" }],
          ["AWS/ApplicationELB", "UnHealthyHostCount", "TargetGroup", "targetgroup/starttech-tg/xxxxx", "LoadBalancer", "app/starttech-alb/xxxxx", { "stat": "Average" }]
        ],
        "period": 300,
        "region": "eu-west-2"
      }
    },
    {
      "type": "metric",
      "x": 0,
      "y": 12,
      "width": 12,
      "height": 6,
      "properties": {
        "title": "Redis CPU Utilization",
        "metrics": [
          ["AWS/ElastiCache", "CPUUtilization", "CacheClusterId", "starttech-redis-001", { "stat": "Average" }],
          ["AWS/ElastiCache", "CPUUtilization", "CacheClusterId", "starttech-redis-002", { "stat": "Average" }]
        ],
        "period": 300,
        "region": "eu-west-2"
      }
    },
    {
      "type": "metric",
      "x": 12,
      "y": 12,
      "width": 12,
      "height": 6,
      "properties": {
        "title": "Redis Connections",
        "metrics": [
          ["AWS/ElastiCache", "CurrConnections", "CacheClusterId", "starttech-redis-001", { "stat": "Average" }],
          ["AWS/ElastiCache", "CurrConnections", "CacheClusterId", "starttech-redis-002", { "stat": "Average" }]
        ],
        "period": 300,
        "region": "eu-west-2"
      }
