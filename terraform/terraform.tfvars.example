# General
name       = "starttech"
aws_region = "us-east-1"

# Networking
vpc_cidr = "10.0.0.0/16"

public_subnet_cidrs = [
"10.0.1.0/24",
"10.0.2.0/24"
]

private_subnet_cidrs = [
"10.0.3.0/24",
"10.0.4.0/24"
]

# Compute
instance_type = "t3.micro"

# GitHub OIDC
github_repo = "your-username/starttech-application"

# Docker
dockerhub_image = "yourusername/starttech-backend"

# Secrets
mongo_uri  = "mongodb+srv://user:password@cluster.mongodb.net/"
jwt_secret = "your-jwt-secret-key"

